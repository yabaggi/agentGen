{
  "summarizer": {
    "name": "📝 Summarizer",
    "agent_name": "summarizer",
    "description": "Summarize content into key points",
    "fields": ["content", "length"],
    "role": "You are an expert content summarizer who creates clear, concise summaries that capture the essential information.",
    "template": "Summarize the following content in {length} sentences:\n\n{content}\n\nProvide a clear, concise summary capturing the main points.",
    "output_format": "plain_text",
    "suggested_model": "gemini-flash",
    "tools": ["text_cleaner"]
  },
  "flashcard": {
    "name": "📚 Flashcard",
    "agent_name": "flashcard_generator",
    "description": "Create Q&A flashcards from content",
    "fields": ["content", "num_cards"],
    "role": "You are an expert educator who creates clear, memorable flashcards optimized for effective learning and retention.",
    "template": "You are a helpful study assistant. Create exactly {num_cards} flashcards from the following text.\n\nRules:\n- Each flashcard must be a clear question and a concise answer (under 30 words).\n- Do NOT include markdown, numbering, or extra text.\n- Avoid yes/no questions.\n- Base answers ONLY on the provided text. Do not invent facts.\n\nText: \"{content}\"\n\nOutput format (one per line):\nQ: [question text]\nA: [answer text]",
    "output_format": "plain_text",
    "suggested_model": "gemini-flash",
    "tools": ["text_cleaner"]
  },
  "email": {
    "name": "✉️ Email",
    "agent_name": "email_writer",
    "description": "Generate professional emails",
    "fields": ["recipient", "subject", "tone", "key_points"],
    "role": "You are a professional email writer who crafts clear, effective, and appropriately toned emails for any situation.",
    "template": "Write a {tone} email to {recipient} about: {subject}\n\nKey points to include:\n{key_points}\n\nOutput only the email text with appropriate greeting and signature.",
    "output_format": "plain_text",
    "suggested_model": "gpt-4o-mini",
    "tools": []
  },
  "qa": {
    "name": "❓ Q&A",
    "agent_name": "qa_bot",
    "description": "Answer questions from context",
    "fields": ["context", "question"],
    "role": "You are a helpful assistant that provides accurate, well-reasoned answers based strictly on the provided context.",
    "template": "Based on the following context, answer the question.\n\nContext:\n{context}\n\nQuestion: {question}\n\nProvide a clear and accurate answer based only on the given context.",
    "output_format": "plain_text",
    "suggested_model": "gemini-pro",
    "tools": ["text_cleaner"]
  },
  "translator": {
    "name": "🌐 Translator",
    "agent_name": "translator",
    "description": "Translate text between languages",
    "fields": ["content", "target_language"],
    "role": "You are an expert translator who provides accurate, natural-sounding translations while preserving the original meaning and tone.",
    "template": "Translate the following text to {target_language}:\n\n{content}\n\nProvide only the translation without any explanations or notes.",
    "output_format": "plain_text",
    "suggested_model": "gpt-4o",
    "tools": ["text_cleaner"]
  },
  "blog_writer": {
    "name": "📰 Blog Writer",
    "agent_name": "blog_writer",
    "description": "Generate blog posts from topics",
    "fields": ["topic", "tone", "word_count"],
    "role": "You are a skilled blog writer who creates engaging, well-structured articles with compelling introductions and clear takeaways.",
    "template": "Write a {tone} blog post about: {topic}\n\nTarget length: approximately {word_count} words.\n\nInclude an engaging introduction, clear sections with headings, and a memorable conclusion.",
    "output_format": "markdown",
    "suggested_model": "gpt-4o",
    "tools": []
  },
  "code_explainer": {
    "name": "💻 Code Explainer",
    "agent_name": "code_explainer",
    "description": "Explain code in simple terms",
    "fields": ["code", "detail_level"],
    "role": "You are a programming teacher who explains code clearly to developers of all skill levels, breaking down complex concepts into understandable parts.",
    "template": "Explain the following code with {detail_level} detail:\n\n{code}\n\nBreak down what each part does and explain the overall purpose. Use clear language appropriate for the detail level requested.",
    "output_format": "markdown",
    "suggested_model": "gpt-4o",
    "tools": []
  },
  "bullet_points": {
    "name": "📋 Bullet Points",
    "agent_name": "bullet_extractor",
    "description": "Extract key points as bullets",
    "fields": ["content", "num_points"],
    "role": "You are an expert at distilling information into clear, actionable bullet points that capture the essence of any content.",
    "template": "Extract exactly {num_points} key bullet points from this content:\n\n{content}\n\nFormat as a clean bulleted list with concise, informative points. Each point should stand alone and convey a complete idea.",
    "output_format": "markdown",
    "suggested_model": "gemini-flash",
    "tools": ["text_cleaner"]
  },
  "pros_cons": {
    "name": "⚖️ Pros & Cons",
    "agent_name": "pros_cons_analyzer",
    "description": "Analyze pros and cons of a topic",
    "fields": ["topic", "num_points"],
    "role": "You are an analytical thinker who provides balanced, objective analysis considering multiple perspectives.",
    "template": "Analyze the pros and cons of: {topic}\n\nProvide exactly {num_points} pros and {num_points} cons.\n\nFormat as two clear sections (Pros and Cons) with bullet points. Be balanced and objective.",
    "output_format": "markdown",
    "suggested_model": "gemini-pro",
    "tools": []
  },
  "social_media": {
    "name": "📱 Social Post",
    "agent_name": "social_post_creator",
    "description": "Create social media posts",
    "fields": ["topic", "platform", "tone"],
    "role": "You are a social media expert who creates engaging, platform-appropriate posts that drive engagement.",
    "template": "Create a {tone} social media post for {platform} about:\n\n{topic}\n\nInclude relevant hashtags and keep it appropriate for the platform's style and character limits. Make it engaging and shareable.",
    "output_format": "plain_text",
    "suggested_model": "gemini-flash",
    "tools": []
  },
  "web_summarizer": {
    "name": "🌍 Web Summarizer",
    "agent_name": "web_summarizer",
    "description": "Summarize content from a URL",
    "fields": ["url", "content", "length"],
    "role": "You are an expert at analyzing web content and creating concise, informative summaries that capture the key information.",
    "template": "Summarize the following web page content in {length} sentences:\n\n{content}\n\nProvide a clear summary highlighting the main points, key facts, and important takeaways.",
    "output_format": "markdown",
    "suggested_model": "gemini-flash",
    "tools": ["web_scraper", "text_cleaner"]
  },
  "rss_digest": {
    "name": "📡 RSS Digest",
    "agent_name": "rss_digest_creator",
    "description": "Create digest from RSS feeds",
    "fields": ["rss_url", "content", "num_items"],
    "role": "You are a news curator who creates clear, organized digests from multiple articles.",
    "template": "Create a digest summarizing the top {num_items} items from this RSS feed content:\n\n{content}\n\nFor each item, provide:\n- A brief headline\n- 2-3 sentence summary\n- Key takeaway\n\nFormat as a clean, organized digest.",
    "output_format": "markdown",
    "suggested_model": "gemini-pro",
    "tools": ["rss_reader", "text_cleaner"]
  },
  "meeting_notes": {
    "name": "📋 Meeting Notes",
    "agent_name": "meeting_notes_formatter",
    "description": "Format raw notes into structured minutes",
    "fields": ["content", "meeting_title"],
    "role": "You are an executive assistant who creates clear, professional meeting minutes from raw notes.",
    "template": "Convert these raw meeting notes into structured meeting minutes for: {meeting_title}\n\nRaw notes:\n{content}\n\nFormat with sections for:\n- Attendees (if mentioned)\n- Key Discussion Points\n- Decisions Made\n- Action Items (with owners if mentioned)\n- Next Steps",
    "output_format": "markdown",
    "suggested_model": "gpt-4o-mini",
    "tools": ["text_cleaner"]
  },
  "product_description": {
    "name": "🛍️ Product Description",
    "agent_name": "product_description_writer",
    "description": "Generate compelling product descriptions",
    "fields": ["product_name", "features", "target_audience"],
    "role": "You are a skilled copywriter who creates compelling, conversion-focused product descriptions.",
    "template": "Write a compelling product description for: {product_name}\n\nKey features:\n{features}\n\nTarget audience: {target_audience}\n\nCreate an engaging description that highlights benefits, addresses the target audience's needs, and includes a call to action.",
    "output_format": "plain_text",
    "suggested_model": "gpt-4o",
    "tools": []
  },
  "data_extractor": {
    "name": "📊 Data Extractor",
    "agent_name": "data_extractor",
    "description": "Extract structured data from text",
    "fields": ["content", "fields_to_extract"],
    "role": "You are a data extraction specialist who accurately identifies and structures information from unstructured text.",
    "template": "Extract the following information from the text below.\n\nFields to extract: {fields_to_extract}\n\nText:\n{content}\n\nProvide the extracted information in a clear, structured format. Use 'Not found' for any fields not present in the text.",
    "output_format": "plain_text",
    "suggested_model": "gpt-4o",
    "tools": ["text_cleaner"]
  },
  "file_analyzer": {
    "name": "📄 File Analyzer",
    "agent_name": "file_analyzer",
    "description": "Analyze content from files",
    "fields": ["file_path", "content", "analysis_type"],
    "role": "You are a document analyst who provides thorough analysis and insights from file contents.",
    "template": "Perform a {analysis_type} analysis on the following file content:\n\n{content}\n\nProvide a comprehensive analysis including:\n- Overview and Summary\n- Key findings\n- Notable patterns or insights\n- Recommendations (if applicable)",
    "output_format": "markdown",
    "suggested_model": "gemini-pro",
    "tools": ["file_reader", "text_cleaner"]
  }
}
