<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Agent Generator</title>
    <link rel="stylesheet" href="{{ url_for('static', filename='css/style.css') }}">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <div class="container">
        <header class="header">
            <h1>🤖 AI Agent Generator</h1>
            <p>Create custom AI agents with a guided wizard</p>
        </header>

        <div class="progress-container">
            <div class="progress-bar">
                <div class="progress-fill" id="progressFill"></div>
            </div>
            <div class="steps">
                <div class="step active" data-step="1">
                    <span class="step-number">1</span>
                    <span class="step-label">Basic Info</span>
                </div>
                <div class="step" data-step="2">
                    <span class="step-number">2</span>
                    <span class="step-label">Model</span>
                </div>
                <div class="step" data-step="3">
                    <span class="step-number">3</span>
                    <span class="step-label">Prompt</span>
                </div>
                <div class="step" data-step="4">
                    <span class="step-number">4</span>
                    <span class="step-label">Tools</span>
                </div>
                <div class="step" data-step="5">
                    <span class="step-number">5</span>
                    <span class="step-label">Output</span>
                </div>
                <div class="step" data-step="6">
                    <span class="step-number">6</span>
                    <span class="step-label">Review</span>
                </div>
            </div>
        </div>

        <div class="form-container">
            <form id="agentForm">
                
                <!-- Step 1: Basic Info -->
                <div class="form-step active" data-step="1">
                    <h2>📝 Basic Information</h2>
                    <p class="step-description">Give your agent a name and description.</p>
                    
                    <div class="form-group">
                        <label for="agentName">Agent Name <span class="required">*</span></label>
                        <input type="text" id="agentName" name="agent_name" 
                               placeholder="e.g., email_drafter, news_summarizer"
                               required>
                        <small>Use snake_case (letters, numbers, underscores only)</small>
                    </div>
                    
                    <div class="form-group">
                        <label for="agentDescription">Description</label>
                        <textarea id="agentDescription" name="agent_description" rows="3"
                                  placeholder="Describe what your agent does..."></textarea>
                    </div>
                </div>

                <!-- Step 2: Model Configuration -->
                <div class="form-step" data-step="2">
                    <h2>🧠 Model Configuration</h2>
                    <p class="step-description">Choose the AI model and define its role.</p>
                    
                    <div class="form-group">
                        <label for="modelSelect">LLM Model <span class="required">*</span></label>
                        <select id="modelSelect" name="model_id" required></select>
                    </div>
                    
                    <div class="form-group">
                        <label for="modelRole">System Role / Persona <span class="required">*</span></label>
                        <textarea id="modelRole" name="model_role" rows="4" required
                                  placeholder="e.g., You are a professional email writer. You write clear, concise, and friendly emails."></textarea>
                        <small>This defines the AI's personality and behavior</small>
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group">
                            <label for="maxTokens">Max Tokens</label>
                            <input type="number" id="maxTokens" name="max_tokens" 
                                   value="500" min="100" max="4000">
                            <small>Maximum response length</small>
                        </div>
                        
                        <div class="form-group">
                            <label for="temperature">Temperature</label>
                            <input type="range" id="temperature" name="temperature" 
                                   min="0" max="1" step="0.1" value="0.7">
                            <div class="range-labels">
                                <span>Precise (0)</span>
                                <span id="tempValue">0.7</span>
                                <span>Creative (1)</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Step 3: Prompt Configuration -->
                <div class="form-step" data-step="3">
                    <h2>💬 Prompt Configuration</h2>
                    <p class="step-description">Define the input fields and prompt template.</p>
                    
                    <div class="form-group">
                        <label for="fieldInput">Required Input Fields <span class="required">*</span></label>
                        <div class="tags-input" id="fieldsContainer">
                            <input type="text" id="fieldInput" placeholder="Type field name and press Enter">
                        </div>
                        <input type="hidden" id="requiredFields" name="required_fields">
                        <small>Press Enter to add each field. Use these in your prompt as {field_name}</small>
                    </div>
                    
                    <div class="form-group">
                        <label for="promptTemplate">Prompt Template <span class="required">*</span></label>
                        <textarea id="promptTemplate" name="prompt_template" rows="8" required
                                  placeholder="Write your prompt here. Use {field_name} for variables.

Example:
Draft a {tone} email about the following topic:
{topic}

Key points to include:
{key_points}

Output only the email text."></textarea>
                        <small>Use {field_name} syntax to insert user inputs</small>
                    </div>
                    
                    <div class="form-group">
                        <label>Quick Templates</label>
                        <div class="template-buttons">
                            <button type="button" class="btn-template" data-template="email">📧 Email</button>
                            <button type="button" class="btn-template" data-template="summarizer">📰 Summarizer</button>
                            <button type="button" class="btn-template" data-template="flashcard">📚 Flashcard</button>
                            <button type="button" class="btn-template" data-template="qa">❓ Q&A</button>
                        </div>
                    </div>
                </div>

                <!-- Step 4: Tools Selection -->
                <div class="form-step" data-step="4">
                    <h2>🔧 Tools Selection</h2>
                    <p class="step-description">Select tools your agent can use (optional).</p>
                    <div class="tools-grid" id="toolsGrid"></div>
                </div>

                <!-- Step 5: Output Format -->
                <div class="form-step" data-step="5">
                    <h2>📤 Output Format</h2>
                    <p class="step-description">Choose how the agent's output should be formatted.</p>
                    <div class="format-grid" id="formatGrid"></div>
                </div>

                <!-- Step 6: Review & Create -->
                <div class="form-step" data-step="6">
                    <h2>✅ Review & Create</h2>
                    <p class="step-description">Review your configuration and create the agent.</p>
                    
                    <div class="review-container">
                        <div class="review-section">
                            <h3>Configuration Summary</h3>
                            <div id="configSummary"></div>
                        </div>
                        
                        <div class="review-section">
                            <h3>File Preview</h3>
                            <div class="tabs">
                                <button type="button" class="tab-btn active" data-tab="config">config.json</button>
                                <button type="button" class="tab-btn" data-tab="agent">agent.py</button>
                                <button type="button" class="tab-btn" data-tab="readme">README.md</button>
                            </div>
                            <div class="tab-content">
                                <pre id="filePreview"><code></code></pre>
                            </div>
                        </div>
                    </div>
                </div>
            </form>

            <!-- Navigation Buttons -->
            <div class="form-navigation">
                <button type="button" class="btn btn-secondary" id="prevBtn" disabled>← Previous</button>
                <button type="button" class="btn btn-primary" id="nextBtn">Next →</button>
                <button type="button" class="btn btn-success" id="createBtn" style="display: none;">🚀 Create Agent</button>
            </div>
        </div>

        <!-- Success Modal -->
        <div class="modal" id="successModal">
            <div class="modal-content">
                <div class="modal-icon">✅</div>
                <h2>Agent Created Successfully!</h2>
                <p id="successMessage"></p>
                <div class="modal-actions">
                    <button type="button" class="btn btn-primary" onclick="location.reload()">Create Another Agent</button>
                </div>
            </div>
        </div>

        <!-- Error Modal -->
        <div class="modal" id="errorModal">
            <div class="modal-content">
                <div class="modal-icon error">❌</div>
                <h2>Error</h2>
                <p id="errorMessage"></p>
                <div class="modal-actions">
                    <button type="button" class="btn btn-secondary" onclick="closeModal('errorModal')">Close</button>
                </div>
            </div>
        </div>
    </div>

    <script src="{{ url_for('static', filename='js/app.js') }}"></script>
</body>
</html>
