<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Agent Generator</title>
    <link rel="stylesheet" href="/static/css/style.css">
</head>
<body>
    <div class="container">
        <header>
            <h1>🤖 AI Agent Generator</h1>
            <p>Create custom AI agents in minutes</p>
        </header>

        <!-- Progress Bar -->
        <div class="progress-container">
            <div class="progress-bar">
                <div class="progress-fill" id="progressFill"></div>
            </div>
            <div class="steps">
                <div class="step active" data-step="1"><span>1</span>Basic Info</div>
                <div class="step" data-step="2"><span>2</span>Model</div>
                <div class="step" data-step="3"><span>3</span>Prompt</div>
                <div class="step" data-step="4"><span>4</span>Tools</div>
                <div class="step" data-step="5"><span>5</span>Output</div>
                <div class="step" data-step="6"><span>6</span>Review</div>
            </div>
        </div>

        <!-- Form Steps -->
        <div class="form-container">
            <!-- Step 1: Basic Info -->
            <div class="form-step active" data-step="1">
                <h2>Basic Information</h2>
                <p class="step-description">Give your agent a name and description</p>
                
                <div class="form-group">
                    <label for="agentName">Agent Name *</label>
                    <input type="text" id="agentName" placeholder="e.g., content_summarizer" required>
                    <span class="hint">Use lowercase letters, numbers, and underscores only</span>
                </div>
                
                <div class="form-group">
                    <label for="agentDescription">Description</label>
                    <textarea id="agentDescription" rows="3" placeholder="Describe what your agent does..."></textarea>
                </div>
            </div>

            <!-- Step 2: Model Config -->
            <div class="form-step" data-step="2">
                <h2>Model Configuration</h2>
                <p class="step-description">Choose the AI model and set its behavior</p>
                
                <div class="form-group">
                    <label for="modelSelect">LLM Model *</label>
                    <select id="modelSelect">
                        <option value="gemini-flash">Loading models...</option>
                    </select>
                </div>
                
                <div class="form-group">
                    <label for="modelRole">System Role / Persona *</label>
                    <textarea id="modelRole" rows="3" placeholder="e.g., You are an expert content writer who creates engaging summaries..."></textarea>
                </div>
                
                <div class="form-row">
                    <div class="form-group">
                        <label for="maxTokens">Max Tokens</label>
                        <input type="number" id="maxTokens" value="1000" min="100" max="4000">
                    </div>
                    <div class="form-group">
                        <label for="temperature">Temperature: <span id="tempValue">0.7</span></label>
                        <input type="range" id="temperature" min="0" max="1" step="0.1" value="0.7">
                    </div>
                </div>
            </div>

            <!-- Step 3: Prompt Config -->
            
            
            <!-- Step 3: Prompt Config -->
<div class="form-step" data-step="3">
    <h2>Prompt Configuration</h2>
    <p class="step-description">Define input fields and prompt template</p>
    
    <div class="form-group">
        <label>Quick Templates</label>
        <div class="template-buttons" id="templateButtons">
            <!-- Buttons loaded dynamically from JSON -->
            <span class="loading-text">Loading templates...</span>
        </div>
    </div>
    
    <div class="form-group">
        <label>Required Input Fields *</label>
        <div class="tags-input" id="fieldsContainer">
            <input type="text" id="fieldInput" placeholder="Type field name, press Enter (e.g., content, num_cards)">
        </div>
        <input type="hidden" id="requiredFields">
        <span class="hint">Separate multiple fields with commas or press Enter after each</span>
    </div>
    
    <div class="form-group">
        <label for="promptTemplate">Prompt Template *</label>
        <textarea id="promptTemplate" rows="8" placeholder="Use {field_name} for variables, e.g., Summarize this: {content}"></textarea>
        <span class="hint">Use {field_name} syntax to insert user inputs into the prompt</span>
    </div>
</div>
            
            
            <!-- Step 4: Tools -->
            <div class="form-step" data-step="4">
                <h2>Tools Selection</h2>
                <p class="step-description">Select tools your agent can use (optional - select multiple)</p>
                
                <div class="tools-grid" id="toolsGrid">
                    <!-- Tools loaded via JS -->
                </div>
            </div>

            <!-- Step 5: Output Format -->
            <div class="form-step" data-step="5">
                <h2>Output Format</h2>
                <p class="step-description">Choose how your agent should format its output</p>
                
                <div class="format-grid" id="formatGrid">
                    <!-- Formats loaded via JS -->
                </div>
            </div>

            <!-- Step 6: Review -->
            <div class="form-step" data-step="6">
                <h2>Review & Create</h2>
                <p class="step-description">Review your configuration before creating the agent</p>
                
                <div class="review-section">
                    <h3>Configuration Summary</h3>
                    <div id="configSummary" class="config-summary"></div>
                </div>
                
                <div class="review-section">
                    <h3>File Preview</h3>
                    <div class="tabs">
                        <button class="tab-btn active" data-tab="config">config.json</button>
                        <button class="tab-btn" data-tab="agent">agent.py</button>
                        <button class="tab-btn" data-tab="readme">README.md</button>
                    </div>
                    <pre id="filePreview"><code>Select a tab to preview file contents</code></pre>
                </div>
            </div>
        </div>

        <!-- Navigation Buttons -->
        <div class="nav-buttons">
            <button id="prevBtn" class="btn btn-secondary" disabled>← Previous</button>
            <button id="nextBtn" class="btn btn-primary">Next →</button>
            <button id="createBtn" class="btn btn-success" style="display: none;">🚀 Create Agent</button>
        </div>
    </div>

    <!-- Success Modal -->
    <div class="modal" id="successModal">
        <div class="modal-content">
            <div class="modal-header success">
                <h2>✅ Agent Created Successfully!</h2>
            </div>
            <div class="modal-body">
                <p id="successMessage"></p>
            </div>
            <div class="modal-footer">
                <button class="btn btn-primary" onclick="closeModal('successModal'); location.reload();">Create Another</button>
            </div>
        </div>
    </div>

    <!-- Error Modal -->
    <div class="modal" id="errorModal">
        <div class="modal-content">
            <div class="modal-header error">
                <h2>❌ Error</h2>
            </div>
            <div class="modal-body">
                <p id="errorMessage"></p>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" onclick="closeModal('errorModal')">Close</button>
            </div>
        </div>
    </div>

    <script src="/static/js/app.js"></script>
</body>
</html>

